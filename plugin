"""officecli dump-reader plugin for OpenDocument Text (.odt).

Reads an .odt file and streams officecli batch commands as JSONL on stdout
(one JSON object per line, flushed individually), per
plugins/plugin-protocol.md v1 §5.1. Main replays them into a sibling .docx.

Anything this reader cannot translate is reported on stderr as a
`[warning] odt:` line and counted in the final summary — never dropped in
silence. (Note that main discards a dump-reader's stderr on a successful
conversion, so that report is visible when the plugin is run directly.)
Embedded images (PNG/JPEG/GIF/BMP/TIFF/SVG) are carried in the emitted command
as data URIs, because main replays the output after this process exits and
never passes --media-dir. The supported construct list is what the manifest
`supports` field declares, and it is what the tests measure.
"""

import base64
import json
import os
import re
import sys
import urllib.parse
import zipfile
import xml.etree.ElementTree as ET

NS = {
    "office": "urn:oasis:names:tc:opendocument:xmlns:office:1.0",
    "text": "urn:oasis:names:tc:opendocument:xmlns:text:1.0",
    "table": "urn:oasis:names:tc:opendocument:xmlns:table:1.0",
    "style": "urn:oasis:names:tc:opendocument:xmlns:style:1.0",
    "fo": "urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0",
    "draw": "urn:oasis:names:tc:opendocument:xmlns:drawing:1.0",
    "svg": "urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0",
    "xlink": "http://www.w3.org/1999/xlink",
}

# ODF length units → points. 1pt = 1/72in; px is the CSS pixel (96dpi).
UNITS_PT = {"cm": 72.0 / 2.54, "mm": 7.2 / 2.54, "in": 72.0,
            "pt": 1.0, "pc": 12.0, "px": 0.75}

# fo:text-align → officecli align value. Only values officecli accepts are
# emitted; anything else is dropped and reported.
ALIGN = {
    "start": "left",
    "left": "left",
    "center": "center",
    "end": "right",
    "right": "right",
    "justify": "justify",
}

BOLD_WEIGHTS = {"bold", "600", "700", "800", "900"}

MAX_REPEAT = 64          # guard against a table:number-columns-repeated bomb

# text:list-style name → "bullet" | "ordered", filled by collect_styles().
LIST_KINDS = {}
MANIFEST = {
    "name": "officecli-odt",
    "version": "0.2.0",
    "protocol": 1,
    "kinds": ["dump-reader"],
    "extensions": [".odt"],
    "target": "docx",
    "runtime": "python",
    "idle_timeout_seconds": {"default": 60, "verbs": {"dump": 30}},
    "tier": "basic",
    "description": "OpenDocument Text (.odt) to .docx dump-reader for officecli",
    "supports": [
        "paragraphs",
        "runs",
        "inline-formatting:bold,italic,underline",
        "heading-levels:1-6",
        "alignment",
        "lists:bullet,ordered",
        "tables:simple",
        "images:png,jpeg,gif,bmp,tiff,svg (inline; sized from the frame)",
    ],
    "limits": {"maxFileSizeMb": 100},
    "license": "MIT",
}

_supports = MANIFEST["supports"]
_supports = list(_supports)


def warn(msg):
    sys.stderr.write("[warning] odt: %s\n" % msg)


class Skipped:
    """Counts constructs we refuse to translate, so the summary is honest."""

    def __init__(self):
        self.counts = {}

    def note(self, what):
        self.counts[what] = self.counts.get(what, 0) + 1

    def report(self):
        for what, n in sorted(self.counts.items()):
            warn("skipped %d x %s" % (n, what))


def q(ns, tag):
    return "{%s}%s" % (NS[ns], tag)


def local(elem):
    t = elem.tag
    return t.split("}", 1)[-1] if "}" in t else t


# ---------------------------------------------------------------------------
# images: sniffing, geometry
# ---------------------------------------------------------------------------
#
# The four magic-byte families below are exactly the ones officecli's own
# ImageSource.TrySniffContentType recognises (PNG, JPEG, GIF, BMP, TIFF, and
# the "<svg"/"<?xml" header for SVG). Anything else — EMF/WMF included — is
# reported as skipped instead of being embedded under a guessed content type:
# a data URI is trusted by main without a magic check, so a wrong MIME here
# would produce a schema-valid document with a broken image in it.

def sniff_image(data):
    """(mime, extension) for a supported embedded image, else None."""
    if len(data) >= 4:
        if data[:4] == b"\x89PNG":
            return ("image/png", "png")
        if data[:3] == b"\xff\xd8\xff":
            return ("image/jpeg", "jpg")
        if data[:4] == b"GIF8":
            return ("image/gif", "gif")
        if data[:2] == b"BM":
            return ("image/bmp", "bmp")
        if data[:4] in (b"II*\x00", b"MM\x00*"):
            return ("image/tiff", "tiff")
    head = data[:512]
    i = 3 if head[:3] == b"\xef\xbb\xbf" else 0
    while i < len(head) and head[i:i + 1] in (b" ", b"\t", b"\r", b"\n"):
        i += 1
    low = head[i:].lower()
    if low.startswith(b"<svg") or low.startswith(b"<?xml") or low.startswith(b"<!doctype svg"):
        return ("image/svg+xml", "svg")
    return None


def pixel_dims(data):
    """(width, height) in pixels, or None — mirrors ImageSource.TryGetDimensions."""
    try:
        if data[:4] == b"\x89PNG" and len(data) >= 24:
            w = int.from_bytes(data[16:20], "big")
            h = int.from_bytes(data[20:24], "big")
            return (w, h) if w > 0 and h > 0 else None
        if data[:4] == b"GIF8" and len(data) >= 10:
            w = data[6] | (data[7] << 8)
            h = data[8] | (data[9] << 8)
            return (w, h) if w > 0 and h > 0 else None
        if data[:2] == b"BM" and len(data) >= 26:
            w = int.from_bytes(data[18:22], "little")
            h = abs(int.from_bytes(data[22:26], "little", signed=True))
            return (w, h) if w > 0 and h > 0 else None
        if data[:3] == b"\xff\xd8\xff":
            return _jpeg_dims(data)
    except (IndexError, ValueError):
        return None
    return None


def _jpeg_dims(data):
    i, n = 2, len(data)
    while i + 9 < n:
        if data[i] != 0xFF:
            return None
        marker = data[i + 1]
        if marker == 0xD8 or marker == 0x01 or 0xD0 <= marker <= 0xD7:
            i += 2
            continue
        if marker == 0xDA:
            return None
        seg = int.from_bytes(data[i + 2:i + 4], "big")
        is_sof = (0xC0 <= marker <= 0xCF) and marker not in (0xC4, 0xC8, 0xCC)
        if is_sof:
            h = int.from_bytes(data[i + 5:i + 7], "big")
            w = int.from_bytes(data[i + 7:i + 9], "big")
            return (w, h) if w > 0 and h > 0 else None
        if seg < 2:
            return None
        i += 2 + seg
    return None


def length_pt(value):
    """ODF length ('5.291cm', '2in', '150pt', '12') → points, or None."""
    if not value:
        return None
    m = re.match(r"^\s*(-?[0-9]*\.?[0-9]+)\s*(cm|mm|in|pt|pc|px)?\s*$", value)
    if not m:
        return None
    return float(m.group(1)) * UNITS_PT[m.group(2) or "px"]


def fmt_pt(points):
    """Points as an officecli length ('12pt'); officecli wants the unit."""
    return ("%.2f" % points).rstrip("0").rstrip(".") + "pt"


# ---------------------------------------------------------------------------
# style resolution
# ---------------------------------------------------------------------------

def collect_styles(root):
    """(family, style-name) → {bold/italic/underline/align} from content.xml.

    Resolves style:parent-style-name one or more levels up, so a run span that
    inherits from a named character style keeps its weight.
    """
    LIST_KINDS.clear()
    for ls in root.iter(q("text", "list-style")):
        ls_name = ls.get(q("style", "name"))
        if not ls_name:
            continue
        kinds = [local(c) for c in ls]
        LIST_KINDS[ls_name] = (
            "bullet" if any(k == "list-level-style-bullet" for k in kinds) else "ordered"
        )

    raw = {}
    parents = {}
    for st in root.iter(q("style", "style")):
        name = st.get(q("style", "name"))
        family = st.get(q("style", "family"))
        if not name or not family:
            continue
        props = {}
        tp = st.find(q("style", "text-properties"))
        if tp is not None:
            weight = (tp.get(q("fo", "font-weight")) or "").lower()
            if weight in BOLD_WEIGHTS:
                props["bold"] = "true"
            if (tp.get(q("fo", "font-style")) or "").lower() == "italic":
                props["italic"] = "true"
            underline = tp.get(q("style", "text-underline-style"))
            if underline and underline != "none":
                props["underline"] = "true"
        pp = st.find(q("style", "paragraph-properties"))
        if pp is not None:
            align = (pp.get(q("fo", "text-align")) or "").lower()
            if align in ALIGN:
                props["align"] = ALIGN[align]
        raw[(family, name)] = props
        parent = st.get(q("style", "parent-style-name"))
        if parent:
            parents[(family, name)] = (family, parent)

    resolved = {}

    def resolve(key, depth=0):
        if key in resolved:
            return resolved[key]
        if depth > 8:
            return {}
        own = dict(raw.get(key, {}))
        parent = parents.get(key)
        if parent and parent != key:
            inherited = resolve(parent, depth + 1)
            merged = dict(inherited)
            merged.update(own)
            own = merged
        resolved[key] = own
        return own

    for key in raw:
        resolve(key)

    # document-wide default paragraph style, if the source declares one
    return resolved, raw


def style_props(styles, family, name):
    if not name:
        return {}
    return styles.get((family, name), {})


def image_items(images, width, height, zf, skipped, alt_hint=None):
    """Turn draw:image elements into ('image', bytes, mime, w, h, alt) items.

    The bytes are carried as a data URI by the emitter, so nothing has to
    survive on disk between this process and main's replay of its output.
    """
    out = []
    for img in images:
        href = img.get(q("xlink", "href"))
        if not href:
            skipped.note("draw:image without xlink:href (linked, not embedded)")
            continue
        if href.startswith("data:") or "://" in href:
            skipped.note("draw:image with an external href (not a package part)")
            continue
        part = urllib.parse.unquote(href)
        try:
            data = zf.read(part)
        except KeyError:
            skipped.note("image part '%s' missing from the package" % part)
            continue
        sniffed = sniff_image(data)
        if sniffed is None:
            skipped.note("image '%s' is not png/jpeg/gif/bmp/tiff/svg"
                         % part.rsplit("/", 1)[-1])
            continue
        mime, _ext = sniffed

        w, h = width, height
        dims = pixel_dims(data)
        if dims:
            ratio = float(dims[1]) / float(dims[0])
            if w is None and h is None:
                w, h = dims[0] * 0.75, dims[1] * 0.75   # CSS pixel = 1/96in
            elif w is None:
                w = h / ratio
            elif h is None:
                h = w * ratio
        elif w is None or h is None:
            skipped.note("image '%s' size unknown (no frame geometry, unreadable header)"
                         % part.rsplit("/", 1)[-1])

        alt = alt_hint or part.rsplit("/", 1)[-1]
        out.append(("image", data, mime, w, h, alt))
    return out


def frame_items(frame, zf, skipped):
    """Items for one draw:frame: its image(s), plus honest notes for the rest."""
    width = length_pt(frame.get(q("svg", "width")))
    height = length_pt(frame.get(q("svg", "height")))
    anchor = frame.get(q("text", "anchor-type"))
    if anchor and anchor != "as-char":
        skipped.note("image anchored '%s' (placed inline instead)" % anchor)

    alt_hint = None
    for tag in ("title", "desc"):
        el = frame.find(q("svg", tag))
        if el is not None and (el.text or "").strip():
            alt_hint = el.text.strip()
            break

    for kid in frame.iter():
        if local(kid) == "text-box":
            skipped.note("text box (draw:text-box): its text is dropped")

    images = [el for el in frame.iter() if local(el) == "image"]
    return image_items(images, width, height, zf, skipped, alt_hint)


# ---------------------------------------------------------------------------
# inline runs
# ---------------------------------------------------------------------------

def inline_items(elem, styles, inherited, skipped, zf):
    """Walk a paragraph-like element and return its inline items in order.

    Each item is ("text", text, props) or ("image", bytes, mime, w, h, alt).
    Order is document order, so "before <image> after" keeps its sequence.
    """
    out = []

    def walk(node, props):
        if node.text:
            out.append(("text", node.text, props))
        for child in node:
            ln = local(child)
            if ln == "s":
                n = child.get(q("text", "c"))
                try:
                    n = int(n) if n is not None else 1
                except ValueError:
                    n = 1
                out.append(("text", " " * max(1, min(n, 1024)), props))
            elif ln == "tab":
                out.append(("text", " ", props))
                skipped.note("text:tab (flattened to a space)")
            elif ln == "line-break":
                out.append(("text", " ", props))
                skipped.note("text:line-break (flattened to a space)")
            elif ln == "span":
                sp = dict(props)
                sp.update(style_props(styles, "text", child.get(q("text", "style-name"))))
                walk(child, sp)
            elif ln == "frame":
                out.extend(frame_items(child, zf, skipped))
            elif ln == "image":
                out.extend(image_items([child], None, None, zf, skipped))
            elif ln == "g":
                # a group of frames: descend, the individual frames are handled
                skipped.note("draw:g group (frames flattened in document order)")
                walk(child, props)
            else:
                if ln == "a":
                    skipped.note("text:a hyperlink (text kept, link dropped)")
                elif ln == "note":
                    skipped.note("text:note footnote/endnote (dropped)")
                elif ln in ("change", "change-start", "change-end"):
                    skipped.note("tracked change markup (flattened)")
                elif ln in ("bookmark", "bookmark-start", "bookmark-end",
                            "reference-mark", "reference-mark-start", "reference-mark-end",
                            "soft-page-break", "ruby"):
                    skipped.note("text:%s (dropped)" % ln)
                elif ln in ("custom-shape", "rect", "circle", "ellipse", "line",
                            "polygon", "polyline", "path", "connector", "caption",
                            "chart", "object", "object-ole", "plugin", "applet",
                            "floating-frame", "handle"):
                    # A drawing, not a picture: there is no raster to embed.
                    skipped.note("draw:%s (vector shape or embedded object, dropped)" % ln)
                # descend so nested text is not lost
                walk(child, props)
            # The tail belongs to the parent's run of text, never to the child:
            # appending it once per child is what keeps "a <span>b</span> c"
            # from collapsing into "abc".
            if child.tail:
                out.append(("text", child.tail, props))

    walk(elem, inherited)
    return [it for it in out if it[0] == "image" or it[1]]


def text_of_items(items):
    return "".join(it[1] for it in items if it[0] == "text")


# ---------------------------------------------------------------------------
# emitters
# ---------------------------------------------------------------------------

class Emitter:
    def __init__(self):
        self.p = 0      # /body/p[N] counter
        self.tbl = 0    # /body/tbl[N] counter
        self.pic = 0    # pictures emitted, for the end-of-run summary

    def emit(self, obj):
        sys.stdout.write(json.dumps(obj, ensure_ascii=False) + "\n")
        sys.stdout.flush()

    def paragraph(self, items, para_props):
        self.p += 1
        path = "/body/p[%d]" % self.p
        props = {k: v for k, v in para_props.items() if v}
        if not items:
            self.emit({"command": "add", "parent": "/body", "type": "paragraph",
                       "props": props})
            return
        # Runs carry the text: setting props.text as well would emit a run with
        # the whole paragraph in it and then append one run per inline segment,
        # duplicating every character.
        self.emit({"command": "add", "parent": "/body", "type": "paragraph",
                   "props": props})
        for it in items:
            if it[0] == "text":
                rp = {"text": it[1]}
                for key in ("bold", "italic", "underline"):
                    if it[2].get(key):
                        rp[key] = "true"
                self.emit({"command": "add", "parent": path, "type": "run",
                           "props": rp})
                continue
            _, data, mime, w_pt, h_pt, alt = it
            # A data URI keeps the image self-contained: main replays this
            # output *after* the plugin exits, and it never passes --media-dir
            # (DumpReaderInvoker passes only "dump <source>"), so a scratch file
            # would either be gone by replay time or leak forever.
            pp = {"src": "data:%s;base64,%s"
                        % (mime, base64.b64encode(data).decode("ascii"))}
            if w_pt is not None:
                pp["width"] = fmt_pt(w_pt)
            if h_pt is not None:
                pp["height"] = fmt_pt(h_pt)
            if alt:
                pp["alt"] = alt
            self.pic += 1
            self.emit({"command": "add", "parent": path, "type": "picture",
                       "props": pp})

    def table(self, grid, skipped):
        self.tbl += 1
        rows = len(grid)
        cols = max((len(r) for r in grid), default=0)
        if rows == 0 or cols == 0:
            skipped.note("table:table with no cells")
            return
        self.emit({"command": "add", "parent": "/body", "type": "table",
                   "props": {"rows": str(rows), "cols": str(cols)}})
        base = "/body/tbl[%d]" % self.tbl
        for r, cells in enumerate(grid, start=1):
            for c, text in enumerate(cells, start=1):
                if not text:
                    continue
                self.emit({"command": "set",
                           "path": "%s/tr[%d]/tc[%d]" % (base, r, c),
                           "props": {"text": text}})


# ---------------------------------------------------------------------------
# document walk
# ---------------------------------------------------------------------------

def cell_text(cell, styles, skipped, zf):
    parts = []
    for kid in cell:
        if local(kid) == "p":
            parts.append(text_of(kid, styles, skipped, zf))
        elif local(kid) == "table":
            skipped.note("nested table:table (cells flattened into the parent cell)")
    return "\n".join(p for p in parts if p)


def text_of(elem, styles, skipped, zf):
    base = style_props(styles, "paragraph", elem.get(q("text", "style-name")))
    items = inline_items(elem, styles, base, skipped, zf)
    for it in items:
        if it[0] == "image":
            skipped.note("image inside a table cell (a cell carries text only)")
    return text_of_items(items)


def block_image_items(elem, zf, skipped):
    """Items for a drawing element sitting directly in office:text."""
    ln = local(elem)
    if ln == "frame":
        return frame_items(elem, zf, skipped)
    if ln == "image":
        return image_items([elem], None, None, zf, skipped)
    if ln == "g":
        skipped.note("draw:g group (frames flattened in document order)")
        out = []
        for kid in elem:
            out.extend(block_image_items(kid, zf, skipped))
        return out
    skipped.note("draw:%s at block level (dropped)" % ln)
    return []


def read_cell(row_cells, skipped):
    """Flatten a row's cells, honouring table:number-columns-repeated."""
    out = []
    for cell in row_cells:
        ln = local(cell)
        if ln == "covered-table-cell":
            rep = cell.get(q("table", "number-columns-repeated"))
            try:
                rep = int(rep) if rep else 1
            except ValueError:
                rep = 1
            out.extend([""] * max(1, min(rep, MAX_REPEAT)))
            continue
        if ln != "table-cell":
            continue
        rep = cell.get(q("table", "number-columns-repeated"))
        try:
            rep = int(rep) if rep else 1
        except ValueError:
            rep = 1
        rep = max(1, min(rep, MAX_REPEAT))
        out.extend([cell] * rep)
    return out


def walk_block(elem, em, styles, skipped, zf, list_kind=None, level=0):
    """Emit one block-level element."""
    ln = local(elem)

    if ln == "h":
        lvl = elem.get(q("text", "outline-level"))
        try:
            lvl = int(lvl) if lvl is not None else 1
        except ValueError:
            lvl = 1
        lvl = max(1, min(6, lvl))
        base = style_props(styles, "paragraph", elem.get(q("text", "style-name")))
        items = inline_items(elem, styles, base, skipped, zf)
        props = {"style": "Heading%d" % lvl}
        if base.get("align"):
            props["align"] = base["align"]
        em.paragraph(items, props)
        return

    if ln == "p":
        base = style_props(styles, "paragraph", elem.get(q("text", "style-name")))
        items = inline_items(elem, styles, base, skipped, zf)
        if not items and elem.find(".//" + q("draw", "image")) is not None:
            # Its only content was an image that was refused (already reported);
            # emitting the paragraph would leave an empty one behind.
            return
        props = {}
        if base.get("align"):
            props["align"] = base["align"]
        if list_kind:
            props["liststyle"] = list_kind
            if level:
                props["level"] = str(level)
        em.paragraph(items, props)
        return

    if ln in ("frame", "image", "g"):
        # A picture that is a direct child of office:text (exported by some
        # writers instead of putting it inside a paragraph).
        items = block_image_items(elem, zf, skipped)
        if items:
            em.paragraph(items, {})
        return

    if ln == "list":
        style_name = elem.get(q("text", "style-name"))
        kind = LIST_KINDS.get(style_name)
        if kind is None:
            kind = "bullet"
            if style_name:
                skipped.note("text:list style '%s' not found (assumed bullet)" % style_name)
            else:
                skipped.note("text:list without text:style-name (assumed bullet)")
        for item in elem:
            if local(item) != "list-item":
                continue
            for kid in item:
                walk_block(kid, em, styles, skipped, zf,
                           list_kind=kind, level=level)
        return

    if ln == "table":
        grid = []
        for row in elem:
            if local(row) != "table-row":
                continue
            cells = read_cell([c for c in row if local(c) in ("table-cell", "covered-table-cell")],
                              skipped)
            grid.append([cell_text(c, styles, skipped, zf) if not isinstance(c, str) else c
                         for c in cells])
        em.table(grid, skipped)
        return

    if ln in ("s", "soft-page-break"):
        return

    if ln == "section":
        for kid in elem:
            walk_block(kid, em, styles, skipped, zf)
        return

    skipped.note("text:%s at block level (dropped)" % ln)


def convert(path):
    skipped = Skipped()
    try:
        zf = zipfile.ZipFile(path)
    except (zipfile.BadZipFile, OSError) as exc:
        sys.stderr.write("not a readable ODF package: %s\n" % exc)
        return 2

    with zf:
        try:
            content = zf.read("content.xml")
        except KeyError:
            sys.stderr.write("package has no content.xml — not an OpenDocument text file\n")
            return 2

        try:
            root = ET.fromstring(content)
        except ET.ParseError as exc:
            sys.stderr.write("content.xml is not well-formed XML: %s\n" % exc)
            return 2

        styles, _raw = collect_styles(root)

        body = root.find(q("office", "body"))
        if body is None:
            sys.stderr.write("content.xml has no office:body\n")
            return 2
        text_el = body.find(q("office", "text"))
        if text_el is None:
            # e.g. a spreadsheet or presentation packaged as .odt
            sys.stderr.write("package is not an OpenDocument text document "
                             "(no office:text body)\n")
            return 3

        # The package stays open for the walk: image bytes are read straight out
        # of it and carried in the emitted commands.
        em = Emitter()
        for kid in text_el:
            walk_block(kid, em, styles, skipped, zf)

    skipped.report()
    warn("emitted %d paragraph(s), %d table(s) and %d image(s)"
         % (em.p, em.tbl, em.pic))
    if em.p == 0 and em.tbl == 0:
        warn("the source produced no translatable blocks")
    return 0


def usage():
    sys.stderr.write(
        "usage: plugin --info\n"
        "       plugin dump <source.odt> [--media-dir <dir>] [--log-file <path>] [--quiet]\n")
    return 64


def main(argv):
    if len(argv) >= 2 and argv[1] == "--info":
        sys.stdout.write(json.dumps(MANIFEST, ensure_ascii=False) + "\n")
        sys.stdout.flush()
        return 0
    if len(argv) >= 3 and argv[1] == "dump":
        source = argv[2]
        if not os.path.isfile(source):
            sys.stderr.write("no such file: %s\n" % source)
            return 2
        return convert(source)
    return usage()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except Exception:
            pass
        sys.exit(0)
