    "svg": "urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0",
    "xlink": "http://www.w3.org/1999/xlink",
}

# ODF length units → points. 1pt = 1/72in; px is the CSS pixel (96dpi).
UNITS_PT = {"cm": 72.0 / 2.54, "mm": 7.2 / 2.54, "in": 72.0,
            "pt": 1.0, "pc": 12.0, "px": 0.75}

# fo:text-align → officecli align value. Only values officecli accepts are
# emitted; anything else is dropped and reported.
ALIGN = {
    "start": "left",
    "left": "left",
    "center": "center",
    "end": "right",
    "right": "right",
    "justify": "justify",
}

BOLD_WEIGHTS = {"bold", "600", "700", "800", "900"}

MAX_REPEAT = 64          # guard against a table:number-columns-repeated bomb

# text:list-style name → "bullet" | "ordered", filled by collect_styles().
LIST_KINDS = {}
