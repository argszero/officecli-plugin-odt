class Emitter:
    def __init__(self):
        self.p = 0      # /body/p[N] counter
        self.tbl = 0    # /body/tbl[N] counter
        self.pic = 0    # pictures emitted, for the end-of-run summary
        self.link = 0   # hyperlinks emitted
        self.note = 0   # footnotes + endnotes emitted
        self.deco = 0   # headers + footers emitted

    def emit(self, obj):
        sys.stdout.write(json.dumps(obj, ensure_ascii=False) + "\n")
        sys.stdout.flush()

    def decoration(self, kind, scope, text, align):
        """One header or footer part. It hangs off the document root, not the body.

        `type` is the docx *scope* (default/first/even), not the element kind:
        the command's own "type" already names that.
        """
        props = {"text": text}
        if scope != "default":
            props["type"] = scope
        if align:
            props["align"] = align
        self.deco += 1
        self.emit({"command": "add", "parent": "/", "type": kind, "props": props})

    def paragraph(self, items, para_props):
        self.p += 1
        path = "/body/p[%d]" % self.p
        props = {k: v for k, v in para_props.items() if v}
        if not items:
            self.emit({"command": "add", "parent": "/body", "type": "paragraph",
                       "props": props})
            return
        # Runs carry the text: setting props.text as well would emit a run with
        # the whole paragraph in it and then append one run per inline segment,
        # duplicating every character.
        self.emit({"command": "add", "parent": "/body", "type": "paragraph",
                   "props": props})
        for it in items:
            if it[0] == "text":
                rp = {"text": it[1]}
                for key in ("bold", "italic", "underline", "strike", "vertAlign"):
                    if it[2].get(key):
                        rp[key] = it[2][key] if key == "vertAlign" else "true"
                self.emit({"command": "add", "parent": path, "type": "run",
                           "props": rp})
                continue
            if it[0] == "note":
                _, kind, text = it
                # Measured: main appends the reference run at the end of the
                # paragraph's run list, so emitting the note in item order is
                # what places the marker where the source had it.
                self.note += 1
                self.emit({"command": "add", "parent": path, "type": kind,
                           "props": {"text": text}})
                continue
            if it[0] == "link":
                _, target, text, meta = it
                hp = {"text": text}
                hp["anchor" if meta.get("kind") == "anchor" else "url"] = target
                self.link += 1
                self.emit({"command": "add", "parent": path, "type": "hyperlink",
                           "props": hp})
                continue
            _, data, mime, w_pt, h_pt, alt = it
            # A data URI keeps the image self-contained: main replays this
            # output *after* the plugin exits, and it never passes --media-dir
            # (DumpReaderInvoker passes only "dump <source>"), so a scratch file
            # would either be gone by replay time or leak forever.
            pp = {"src": "data:%s;base64,%s"
                        % (mime, base64.b64encode(data).decode("ascii"))}
            if w_pt is not None:
                pp["width"] = fmt_pt(w_pt)
            if h_pt is not None:
                pp["height"] = fmt_pt(h_pt)
            if alt:
                pp["alt"] = alt
            self.pic += 1
            self.emit({"command": "add", "parent": path, "type": "picture",
                       "props": pp})

    def table(self, grid, skipped):
        self.tbl += 1
        rows = len(grid)
        cols = max((len(r) for r in grid), default=0)
        if rows == 0 or cols == 0:
            skipped.note("table:table with no cells")
            return
        self.emit({"command": "add", "parent": "/body", "type": "table",
                   "props": {"rows": str(rows), "cols": str(cols)}})
        base = "/body/tbl[%d]" % self.tbl
        # Vertical merges are emitted after every cell's text has landed: a
        # `vmerge=continue` only marks a slot, and the restarting cell above it
        # must already exist when that mark is written.
        vmerges = []
        for r, row in enumerate(grid, start=1):
            tc = 0          # officecli's own tc index — NOT the ODF column
            for cell in row:
                if cell is None:
                    # Covered by a colspan: that cell's gridSpan already spans
                    # this slot, so no tc of its own is created for it.
                    continue
                tc += 1
                path = "%s/tr[%d]/tc[%d]" % (base, r, tc)
                props = {}
                if cell["text"]:
                    props["text"] = cell["text"]
                if cell["colspan"] > 1:
                    props["colspan"] = str(cell["colspan"])
                if props:
                    self.emit({"command": "set", "path": path, "props": props})
                span = cell["rowspan"]
                if span > 1:
                    vmerges.append((path, "restart", span))
                    for k in range(1, span):
                        vmerges.append(("%s/tr[%d]/tc[%d]" % (base, r + k, tc),
                                        "continue", 0))
        for path, mode, _span in vmerges:
            self.emit({"command": "set", "path": path, "props": {"vmerge": mode}})

# ---------------------------------------------------------------------------
# master pages: headers and footers
# ---------------------------------------------------------------------------

# ODF hangs a header/footer on a *master page*, not on the section. The
# `-left` variants are the left-hand (even) pages of a mirrored layout, which is
# docx's `even` scope. ODF has no `style:header-first`: a different first page is
# a separate master page, so that case is reported instead of guessed at.
DECORATIONS = (
    ("header", "header", "default"),
    ("footer", "footer", "default"),
    ("header", "header-left", "even"),
    ("footer", "footer-left", "even"),
)


def master_pages(root):
    ms = root.find(q("office", "master-styles"))
    if ms is None:
        return []
    return [e for e in ms if local(e) == "master-page"]


def used_master_page(pages, text_el, skipped):
    """The master page the first block asks for, else Standard, else the first."""
    if not pages:
        return None
    named = None
    for el in text_el.iter():
        v = el.get(q("style", "master-page-name"))
        if v:
            named = v
            break
    if named:
        for p in pages:
            if p.get(q("style", "name")) == named:
                return p
        skipped.note("style:master-page-name '%s' is not among the master pages "
                     "(the first one is used)" % named)
    for p in pages:
        if p.get(q("style", "name")) == "Standard":
            return p
    return pages[0]


def decoration_text(elem, styles, skipped, zf):
    """(text, align, paragraph count) for one style:header / style:footer."""
    paras, aligns = [], []
    for kid in elem:
        if local(kid) != "p":
            # The prefix is the element's own, not a guess: a table in a
            # header is table:table, and stamping "text:" on it names a
            # construct that does not exist — which is a name nobody can find.
            skipped.note("%s inside a header/footer (dropped)" % named(kid))
            continue
        base = style_props(styles, "paragraph", kid.get(q("text", "style-name")))
        items = inline_items(kid, styles, base, skipped, zf)
        for it in items:
            if it[0] == "image":
                skipped.note("image inside a header/footer (dropped)")
            elif it[0] == "note":
                skipped.note("text:note inside a header/footer (dropped)")
            elif it[0] == "link":
                skipped.note("hyperlink inside a header/footer (text kept, link dropped)")
        # A part is one string here; a link's text survives, the link does not.
        text = "".join(it[1] if it[0] == "text" else it[2]
                       for it in items if it[0] in ("text", "link"))
        if text:
            paras.append(text)
            aligns.append(base.get("align"))
    if not paras:
        return "", None, 0
    if len(set(a for a in aligns if a)) > 1:
        skipped.note("header/footer paragraphs disagree on alignment "
                     "(the first one wins)")
    return "\n".join(paras), next((a for a in aligns if a), None), len(paras)


def emit_master_page(page, total, em, styles, skipped, zf):
    for kind, tag, scope in DECORATIONS:
        elem = page.find(q("style", tag))
        if elem is None:
            continue
        text, align, n = decoration_text(elem, styles, skipped, zf)
        if not text:
            skipped.note("empty style:%s (dropped)" % tag)
            continue
        if n > 1:
            skipped.note("style:%s with %d paragraphs "
                         "(joined with a line break)" % (tag, n))
        em.decoration(kind, scope, text, align)
    if total > 1:
        skipped.note("%d other master page(s) not converted "
                     "(a different first page is a separate master page in ODF)"
                     % (total - 1))


# ---------------------------------------------------------------------------
# document walk
# ---------------------------------------------------------------------------

def cell_text(cell, styles, skipped, zf):
    parts = []
    for kid in cell:
        if local(kid) == "p":
            parts.append(text_of(kid, styles, skipped, zf))
        elif local(kid) == "table":
            skipped.note("nested table:table (cells flattened into the parent cell)")
    return "\n".join(p for p in parts if p)


def text_of(elem, styles, skipped, zf):
    base = style_props(styles, "paragraph", elem.get(q("text", "style-name")))
    items = inline_items(elem, styles, base, skipped, zf)
    for it in items:
        if it[0] == "image":
            skipped.note("image inside a table cell (a cell carries text only)")
    return text_of_items(items)


def block_image_items(elem, zf, skipped):
    """Items for a drawing element sitting directly in office:text."""
    ln = local(elem)
    if ln == "frame":
        return frame_items(elem, zf, skipped)
    if ln == "image":
        return image_items([elem], None, None, zf, skipped)
    if ln == "g":
        skipped.note("draw:g group (frames flattened in document order)")
        out = []
        for kid in elem:
            out.extend(block_image_items(kid, zf, skipped))
        return out
    skipped.note("draw:%s at block level (dropped)" % ln)
    return []


def read_cell(row_cells, skipped):
    """Flatten a row's cells into (cell_element_or_None, span) pairs.

    `table:number-columns-repeated` repeats a cell; `covered-table-cell` is the
    slot a horizontal merge swallowed, so it becomes a placeholder the caller
    skips rather than a cell of its own.
    """
    out = []
    for cell in row_cells:
        ln = local(cell)
        if ln == "covered-table-cell":
            rep = _repeat(cell)
            out.extend([(None, 1)] * rep)
            continue
        if ln != "table-cell":
            continue
        rep = _repeat(cell)
        out.extend([(cell, 1)] * rep)
    return out


def _repeat(cell):
    rep = cell.get(q("table", "number-columns-repeated"))
    try:
        rep = int(rep) if rep else 1
    except ValueError:
        rep = 1
    return max(1, min(rep, MAX_REPEAT))


def _span(cell, attr):
    v = cell.get(q("table", attr))
    try:
        v = int(v) if v else 1
    except ValueError:
        v = 1
    return max(1, min(v, MAX_REPEAT))


def walk_block(elem, em, styles, skipped, zf, list_kind=None, level=0):
    """Emit one block-level element."""
    ln = local(elem)

    if ln == "h":
        lvl = elem.get(q("text", "outline-level"))
        try:
            lvl = int(lvl) if lvl is not None else 1
        except ValueError:
            lvl = 1
        lvl = max(1, min(6, lvl))
        base = style_props(styles, "paragraph", elem.get(q("text", "style-name")))
        items = inline_items(elem, styles, base, skipped, zf)
        props = {"style": "Heading%d" % lvl}
        if base.get("align"):
            props["align"] = base["align"]
        em.paragraph(items, props)
        return

    if ln == "p":
        base = style_props(styles, "paragraph", elem.get(q("text", "style-name")))
        items = inline_items(elem, styles, base, skipped, zf)
        if not items and elem.find(".//" + q("draw", "image")) is not None:
            # Its only content was an image that was refused (already reported);
            # emitting the paragraph would leave an empty one behind.
            return
        props = {}
        if base.get("align"):
            props["align"] = base["align"]
        if list_kind:
            props["liststyle"] = list_kind
            if level:
                props["level"] = str(level)
        em.paragraph(items, props)
        return

    if ln in ("frame", "image", "g"):
        # A picture that is a direct child of office:text (exported by some
        # writers instead of putting it inside a paragraph).
        items = block_image_items(elem, zf, skipped)
        if items:
            em.paragraph(items, {})
        return

    if ln == "list":
        style_name = elem.get(q("text", "style-name"))
        kind = LIST_KINDS.get(style_name)
        if kind is None:
            kind = "bullet"
            if style_name:
                skipped.note("text:list style '%s' not found (assumed bullet)" % style_name)
            else:
                skipped.note("text:list without text:style-name (assumed bullet)")
        for item in elem:
            if local(item) == "list-header":
                # A list header is the list's lead-in: paragraphs that carry no
                # marker. Word's list model has no such slot, so they become
                # plain paragraphs. Skipping them is what made a LibreOffice
                # document whose every paragraph sat in a list header convert to
                # an empty file, with rc 0 and nothing said about why.
                for kid in item:
                    walk_block(kid, em, styles, skipped, zf)
                continue
            if local(item) != "list-item":
                # Neither an item nor a header: named, so it cannot leave the
                # document without a word.
                skipped.note("%s inside a text:list (dropped)" % named(item))
                continue
            for kid in item:
                # A list *inside* a list item is the next level down. The level
                # was previously passed through unchanged, so a nested list
                # emitted at its parent's depth and every item read back as one
                # flat run.
                nested = local(kid) == "list"
                walk_block(kid, em, styles, skipped, zf,
                           list_kind=kind,
                           level=level + 1 if nested else level)
        return

    if ln == "table":
        grid = []
        for row in elem:
            if local(row) != "table-row":
                continue
            cells = read_cell([c for c in row if local(c) in ("table-cell", "covered-table-cell")],
                              skipped)
            out_row = []
            for cell, _rep in cells:
                if cell is None:
                    # A covered slot: its column was already claimed by the
                    # gridSpan of the cell to its left.
                    out_row.append(None)
                    continue
                out_row.append({
                    "text": cell_text(cell, styles, skipped, zf),
                    "colspan": _span(cell, "number-columns-spanned"),
                    "rowspan": _span(cell, "number-rows-spanned"),
                })
            grid.append(out_row)
        em.table(grid, skipped)
        return

    if ln in ("s", "soft-page-break"):
        return

    if ln == "section":
        for kid in elem:
            walk_block(kid, em, styles, skipped, zf)
        return

    skipped.note("text:%s at block level (dropped)" % ln)


def convert(path):
    skipped = Skipped()
    try:
        zf = zipfile.ZipFile(path)
    except (zipfile.BadZipFile, OSError) as exc:
        sys.stderr.write("not a readable ODF package: %s\n" % exc)
        return 2

    with zf:
        try:
            content = zf.read("content.xml")
        except KeyError:
            sys.stderr.write("package has no content.xml — not an OpenDocument text file\n")
            return 2

        try:
            root = ET.fromstring(content)
        except ET.ParseError as exc:
            sys.stderr.write("content.xml is not well-formed XML: %s\n" % exc)
            return 2

        # styles.xml is where Writer keeps the named styles *and* the master
        # pages that carry headers and footers; content.xml carries the
        # automatic styles the body refers to. A package without styles.xml is
        # legal, so its absence is not an error.
        styles_root = None
        try:
            styles_root = ET.fromstring(zf.read("styles.xml"))
        except KeyError:
            pass
        except ET.ParseError as exc:
            skipped.note("styles.xml is not well-formed XML (%s); its named "
                         "styles and master pages are ignored" % exc)

        if styles_root is not None:
            styles, _raw = collect_styles(styles_root)
            automatic, _raw2 = collect_styles(root, reset=False)
            styles.update(automatic)
        else:
            styles, _raw = collect_styles(root)

        body = root.find(q("office", "body"))
        if body is None:
            sys.stderr.write("content.xml has no office:body\n")
            return 2
        text_el = body.find(q("office", "text"))
        if text_el is None:
            # e.g. a spreadsheet or presentation packaged as .odt
            sys.stderr.write("package is not an OpenDocument text document "
                             "(no office:text body)\n")
            return 3

        # The package stays open for the walk: image bytes are read straight out
        # of it and carried in the emitted commands.
        em = Emitter()
        # Headers and footers live on the master page, which sits beside
        # office:body rather than inside it, so they are read before the walk.
        pages = master_pages(styles_root) if styles_root is not None else []
        if not pages:
            # Non-conforming packages (and older fixtures) keep the master page
            # beside the body instead; it is honoured rather than ignored.
            pages = master_pages(root)
        page = used_master_page(pages, text_el, skipped)
        if page is not None:
            emit_master_page(page, len(pages), em, styles, skipped, zf)
        for kid in text_el:
            walk_block(kid, em, styles, skipped, zf)

    skipped.report()
    if em.deco:
        warn("emitted %d header/footer part(s)" % em.deco)
    if em.note:
        warn("emitted %d note(s)" % em.note)
    warn("emitted %d paragraph(s), %d table(s) and %d image(s)"
         % (em.p, em.tbl, em.pic))
    if em.p == 0 and em.tbl == 0:
        warn("the source produced no translatable blocks")
    return 0


def usage():
    sys.stderr.write(
        "usage: plugin --info\n"
        "       plugin dump <source.odt> [--media-dir <dir>] [--log-file <path>] [--quiet]\n")
    return 64


def main(argv):
    if len(argv) >= 2 and argv[1] == "--info":
        sys.stdout.write(json.dumps(MANIFEST, ensure_ascii=False) + "\n")
        sys.stdout.flush()
        return 0
    if len(argv) >= 3 and argv[1] == "dump":
        source = argv[2]
        if not os.path.isfile(source):
            sys.stderr.write("no such file: %s\n" % source)
            return 2
        return convert(source)
    return usage()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except Exception:
            pass
        sys.exit(0)
