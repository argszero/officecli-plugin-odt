"""officecli dump-reader plugin for OpenDocument Text (.odt).

Reads an .odt file and streams officecli batch commands as JSONL on stdout
(one JSON object per line, flushed individually), per
plugins/plugin-protocol.md v1 §5.1. Main replays them into a sibling .docx.

Anything this reader cannot translate is reported on stderr as a
`[warning] odt:` line and counted in the final summary — never dropped in
silence. The supported construct list is what the manifest `supports`
field declares, and it is what the tests measure.
"""

import json
import os
import sys
import zipfile
import xml.etree.ElementTree as ET

NS = {
    "office": "urn:oasis:names:tc:opendocument:xmlns:office:1.0",
    "text": "urn:oasis:names:tc:opendocument:xmlns:text:1.0",
    "table": "urn:oasis:names:tc:opendocument:xmlns:table:1.0",
    "style": "urn:oasis:names:tc:opendocument:xmlns:style:1.0",
    "fo": "urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0",
    "draw": "urn:oasis:names:tc:opendocument:xmlns:drawing:1.0",
}

# fo:text-align → officecli align value. Only values officecli accepts are
# emitted; anything else is dropped and reported.
ALIGN = {
    "start": "left",
    "left": "left",
    "center": "center",
    "end": "right",
    "right": "right",
    "justify": "justify",
}

BOLD_WEIGHTS = {"bold", "600", "700", "800", "900"}

MAX_REPEAT = 64          # guard against a table:number-columns-repeated bomb

# text:list-style name → "bullet" | "ordered", filled by collect_styles().
LIST_KINDS = {}
MANIFEST = {
    "name": "officecli-odt",
    "version": "0.1.0",
    "protocol": 1,
    "kinds": ["dump-reader"],
    "extensions": [".odt"],
    "target": "docx",
    "runtime": "python",
    "idle_timeout_seconds": {"default": 60, "verbs": {"dump": 30}},
    "tier": "basic",
    "description": "OpenDocument Text (.odt) to .docx dump-reader for officecli",
    "supports": [
        "paragraphs",
        "runs",
        "inline-formatting:bold,italic,underline",
        "heading-levels:1-6",
        "alignment",
        "lists:bullet,ordered",
        "tables:simple",
    ],
    "limits": {"maxFileSizeMb": 100},
    "license": "MIT",
}

_supports = MANIFEST["supports"]
_supports = list(_supports)


def warn(msg):
    sys.stderr.write("[warning] odt: %s\n" % msg)


class Skipped:
    """Counts constructs we refuse to translate, so the summary is honest."""

    def __init__(self):
        self.counts = {}

    def note(self, what):
        self.counts[what] = self.counts.get(what, 0) + 1

    def report(self):
        for what, n in sorted(self.counts.items()):
            warn("skipped %d x %s" % (n, what))


def q(ns, tag):
    return "{%s}%s" % (NS[ns], tag)


def local(elem):
    t = elem.tag
    return t.split("}", 1)[-1] if "}" in t else t


# ---------------------------------------------------------------------------
# style resolution
# ---------------------------------------------------------------------------

def collect_styles(root):
    """(family, style-name) → {bold/italic/underline/align} from content.xml.

    Resolves style:parent-style-name one or more levels up, so a run span that
    inherits from a named character style keeps its weight.
    """
    LIST_KINDS.clear()
    for ls in root.iter(q("text", "list-style")):
        ls_name = ls.get(q("style", "name"))
        if not ls_name:
            continue
        kinds = [local(c) for c in ls]
        LIST_KINDS[ls_name] = (
            "bullet" if any(k == "list-level-style-bullet" for k in kinds) else "ordered"
        )

    raw = {}
    parents = {}
    for st in root.iter(q("style", "style")):
        name = st.get(q("style", "name"))
        family = st.get(q("style", "family"))
        if not name or not family:
            continue
        props = {}
        tp = st.find(q("style", "text-properties"))
        if tp is not None:
            weight = (tp.get(q("fo", "font-weight")) or "").lower()
            if weight in BOLD_WEIGHTS:
                props["bold"] = "true"
            if (tp.get(q("fo", "font-style")) or "").lower() == "italic":
                props["italic"] = "true"
            underline = tp.get(q("style", "text-underline-style"))
            if underline and underline != "none":
                props["underline"] = "true"
        pp = st.find(q("style", "paragraph-properties"))
        if pp is not None:
            align = (pp.get(q("fo", "text-align")) or "").lower()
            if align in ALIGN:
                props["align"] = ALIGN[align]
        raw[(family, name)] = props
        parent = st.get(q("style", "parent-style-name"))
        if parent:
            parents[(family, name)] = (family, parent)

    resolved = {}

    def resolve(key, depth=0):
        if key in resolved:
            return resolved[key]
        if depth > 8:
            return {}
        own = dict(raw.get(key, {}))
        parent = parents.get(key)
        if parent and parent != key:
            inherited = resolve(parent, depth + 1)
            merged = dict(inherited)
            merged.update(own)
            own = merged
        resolved[key] = own
        return own

    for key in raw:
        resolve(key)

    # document-wide default paragraph style, if the source declares one
    return resolved, raw


def style_props(styles, family, name):
    if not name:
        return {}
    return styles.get((family, name), {})


# ---------------------------------------------------------------------------
# inline runs
# ---------------------------------------------------------------------------

def inline_runs(elem, styles, inherited, skipped):
    """Walk a paragraph-like element and return [(text, props)] in order."""
    out = []

    def walk(node, props):
        if node.text:
            out.append((node.text, props))
        for child in node:
            ln = local(child)
            if ln == "s":
                n = child.get(q("text", "c"))
                try:
                    n = int(n) if n is not None else 1
                except ValueError:
                    n = 1
                out.append((" " * max(1, min(n, 1024)), props))
            elif ln == "tab":
                out.append((" ", props))
                skipped.note("text:tab (flattened to a space)")
            elif ln == "line-break":
                out.append((" ", props))
                skipped.note("text:line-break (flattened to a space)")
            elif ln == "span":
                sp = dict(props)
                sp.update(style_props(styles, "text", child.get(q("text", "style-name"))))
                walk(child, sp)
            else:
                if ln == "a":
                    skipped.note("text:a hyperlink (text kept, link dropped)")
                elif ln == "note":
                    skipped.note("text:note footnote/endnote (dropped)")
                elif ln in ("change", "change-start", "change-end"):
                    skipped.note("tracked change markup (flattened)")
                elif ln in ("bookmark", "bookmark-start", "bookmark-end",
                            "reference-mark", "reference-mark-start", "reference-mark-end",
                            "soft-page-break", "ruby"):
                    skipped.note("text:%s (dropped)" % ln)
                # descend so nested text is not lost
                walk(child, props)
            # The tail belongs to the parent's run of text, never to the child:
            # appending it once per child is what keeps "a <span>b</span> c"
            # from collapsing into "abc".
            if child.tail:
                out.append((child.tail, props))

    walk(elem, inherited)
    return [(t, p) for t, p in out if t]


# ---------------------------------------------------------------------------
# emitters
# ---------------------------------------------------------------------------

class Emitter:
    def __init__(self):
        self.p = 0      # /body/p[N] counter
        self.tbl = 0    # /body/tbl[N] counter

    def emit(self, obj):
        sys.stdout.write(json.dumps(obj, ensure_ascii=False) + "\n")
        sys.stdout.flush()

    def paragraph(self, text, para_props, runs=None):
        self.p += 1
        path = "/body/p[%d]" % self.p
        props = {k: v for k, v in para_props.items() if v}
        if runs is None:
            if text:
                props["text"] = text
            self.emit({"command": "add", "parent": "/body", "type": "paragraph",
                       "props": props})
            return
        # Runs carry the text: setting props.text as well would emit a run with
        # the whole paragraph in it and then append one run per inline segment,
        # duplicating every character.
        self.emit({"command": "add", "parent": "/body", "type": "paragraph",
                   "props": props})
        for run_text, run_props in runs:
            rp = {"text": run_text}
            for key in ("bold", "italic", "underline"):
                if run_props.get(key):
                    rp[key] = "true"
            self.emit({"command": "add", "parent": path, "type": "run", "props": rp})

    def table(self, grid, skipped):
        self.tbl += 1
        rows = len(grid)
        cols = max((len(r) for r in grid), default=0)
        if rows == 0 or cols == 0:
            skipped.note("table:table with no cells")
            return
        self.emit({"command": "add", "parent": "/body", "type": "table",
                   "props": {"rows": str(rows), "cols": str(cols)}})
        base = "/body/tbl[%d]" % self.tbl
        for r, cells in enumerate(grid, start=1):
            for c, text in enumerate(cells, start=1):
                if not text:
                    continue
                self.emit({"command": "set",
                           "path": "%s/tr[%d]/tc[%d]" % (base, r, c),
                           "props": {"text": text}})


# ---------------------------------------------------------------------------
# document walk
# ---------------------------------------------------------------------------

def cell_text(cell, styles, skipped):
    parts = []
    for kid in cell:
        if local(kid) == "p":
            parts.append(text_of(kid, styles, skipped))
        elif local(kid) == "table":
            skipped.note("nested table:table (cells flattened into the parent cell)")
    return "\n".join(p for p in parts if p)


def text_of(elem, styles, skipped):
    base = style_props(styles, "paragraph", elem.get(q("text", "style-name")))
    runs = inline_runs(elem, styles, base, skipped)
    return "".join(t for t, _ in runs)


def read_cell(row_cells, skipped):
    """Flatten a row's cells, honouring table:number-columns-repeated."""
    out = []
    for cell in row_cells:
        ln = local(cell)
        if ln == "covered-table-cell":
            rep = cell.get(q("table", "number-columns-repeated"))
            try:
                rep = int(rep) if rep else 1
            except ValueError:
                rep = 1
            out.extend([""] * max(1, min(rep, MAX_REPEAT)))
            continue
        if ln != "table-cell":
            continue
        rep = cell.get(q("table", "number-columns-repeated"))
        try:
            rep = int(rep) if rep else 1
        except ValueError:
            rep = 1
        rep = max(1, min(rep, MAX_REPEAT))
        out.extend([cell] * rep)
    return out


def walk_block(elem, em, styles, skipped, list_kind=None, level=0):
    """Emit one block-level element."""
    ln = local(elem)

    if ln == "h":
        lvl = elem.get(q("text", "outline-level"))
        try:
            lvl = int(lvl) if lvl is not None else 1
        except ValueError:
            lvl = 1
        lvl = max(1, min(6, lvl))
        base = style_props(styles, "paragraph", elem.get(q("text", "style-name")))
        runs = inline_runs(elem, styles, base, skipped)
        text = "".join(t for t, _ in runs)
        props = {"style": "Heading%d" % lvl}
        if base.get("align"):
            props["align"] = base["align"]
        em.paragraph(text, props, runs or None)
        return

    if ln == "p":
        base = style_props(styles, "paragraph", elem.get(q("text", "style-name")))
        runs = inline_runs(elem, styles, base, skipped)
        text = "".join(t for t, _ in runs)
        props = {}
        if base.get("align"):
            props["align"] = base["align"]
        if list_kind:
            props["liststyle"] = list_kind
            if level:
                props["level"] = str(level)
        em.paragraph(text, props, runs or None)
        return

    if ln == "list":
        style_name = elem.get(q("text", "style-name"))
        kind = LIST_KINDS.get(style_name)
        if kind is None:
            kind = "bullet"
            if style_name:
                skipped.note("text:list style '%s' not found (assumed bullet)" % style_name)
            else:
                skipped.note("text:list without text:style-name (assumed bullet)")
        for item in elem:
            if local(item) != "list-item":
                continue
            for kid in item:
                walk_block(kid, em, styles, skipped,
                           list_kind=kind, level=level)
        return

    if ln == "table":
        grid = []
        for row in elem:
            if local(row) != "table-row":
                continue
            cells = read_cell([c for c in row if local(c) in ("table-cell", "covered-table-cell")],
                              skipped)
            grid.append([cell_text(c, styles, skipped) if not isinstance(c, str) else c
                         for c in cells])
        em.table(grid, skipped)
        return

    if ln in ("s", "soft-page-break"):
        return

    if ln == "section":
        for kid in elem:
            walk_block(kid, em, styles, skipped)
        return

    skipped.note("text:%s at block level (dropped)" % ln)


def convert(path):
    skipped = Skipped()
    try:
        zf = zipfile.ZipFile(path)
    except (zipfile.BadZipFile, OSError) as exc:
        sys.stderr.write("not a readable ODF package: %s\n" % exc)
        return 2

    with zf:
        try:
            content = zf.read("content.xml")
        except KeyError:
            sys.stderr.write("package has no content.xml — not an OpenDocument text file\n")
            return 2

    try:
        root = ET.fromstring(content)
    except ET.ParseError as exc:
        sys.stderr.write("content.xml is not well-formed XML: %s\n" % exc)
        return 2

    styles, _raw = collect_styles(root)

    body = root.find(q("office", "body"))
    if body is None:
        sys.stderr.write("content.xml has no office:body\n")
        return 2
    text_el = body.find(q("office", "text"))
    if text_el is None:
        # e.g. a spreadsheet or presentation packaged as .odt
        sys.stderr.write("package is not an OpenDocument text document "
                         "(no office:text body)\n")
        return 3

    em = Emitter()
    for kid in text_el:
        walk_block(kid, em, styles, skipped)

    skipped.report()
    warn("emitted %d paragraph(s) and %d table(s)" % (em.p, em.tbl))
    if em.p == 0 and em.tbl == 0:
        warn("the source produced no translatable blocks")
    return 0


def usage():
    sys.stderr.write(
        "usage: plugin --info\n"
        "       plugin dump <source.odt> [--media-dir <dir>] [--log-file <path>] [--quiet]\n")
    return 64


def main(argv):
    if len(argv) >= 2 and argv[1] == "--info":
        sys.stdout.write(json.dumps(MANIFEST, ensure_ascii=False) + "\n")
        sys.stdout.flush()
        return 0
    if len(argv) >= 3 and argv[1] == "dump":
        source = argv[2]
        if not os.path.isfile(source):
            sys.stderr.write("no such file: %s\n" % source)
            return 2
        return convert(source)
    return usage()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except Exception:
            pass
        sys.exit(0)
