def warn(msg):
    sys.stderr.write("[warning] odt: %s\n" % msg)


class Skipped:
    """Counts constructs we refuse to translate, so the summary is honest."""

    def __init__(self):
        self.counts = {}

    def note(self, what):
        self.counts[what] = self.counts.get(what, 0) + 1

    def report(self):
        for what, n in sorted(self.counts.items()):
            warn("skipped %d x %s" % (n, what))


def q(ns, tag):
    return "{%s}%s" % (NS[ns], tag)


def local(elem):
    t = elem.tag
    return t.split("}", 1)[-1] if "}" in t else t


NS_PREFIX = {
    "urn:oasis:names:tc:opendocument:xmlns:office:1.0": "office",
    "urn:oasis:names:tc:opendocument:xmlns:text:1.0": "text",
    "urn:oasis:names:tc:opendocument:xmlns:drawing:1.0": "draw",
    "urn:oasis:names:tc:opendocument:xmlns:style:1.0": "style",
    "urn:oasis:names:tc:opendocument:xmlns:table:1.0": "table",
    "urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0": "svg",
    "urn:oasis:names:tc:opendocument:xmlns:meta:1.0": "meta",
    "urn:oasis:names:tc:opendocument:xmlns:datastyle:1.0": "number",
    "urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0": "fo",
    "http://purl.org/dc/elements/1.1/": "dc",
    "http://www.w3.org/1999/xlink": "xlink",
}


def named(elem):
    """The element as ODF spells it, e.g. 'text:bookmark-ref'.

    A message carrying only the local name does not resolve for a reader: ODF
    has both a text:note and a draw:frame, and the prefix is the one thing that
    says which vocabulary a construct belongs to.
    """
    tag = elem.tag
    if not isinstance(tag, str) or not tag.startswith("{"):
        return local(elem)
    uri, name = tag[1:].split("}", 1)
    prefix = NS_PREFIX.get(uri)
    if prefix is None:
        # Deriving a prefix by cutting the namespace URI is how this once printed
        # ':creator' for dc:creator: the URI ends in '/', so the cut was empty and
        # the report named a construct that exists in no vocabulary. Never empty.
        prefix = uri.rstrip("/:#").rsplit("/", 1)[-1].rsplit(":", 1)[-1] or "unknown"
    return "%s:%s" % (prefix, name)


# ---------------------------------------------------------------------------
# images: sniffing, geometry
# ---------------------------------------------------------------------------
#
# The four magic-byte families below are exactly the ones officecli's own
# ImageSource.TrySniffContentType recognises (PNG, JPEG, GIF, BMP, TIFF, and
# the "<svg"/"<?xml" header for SVG). Anything else — EMF/WMF included — is
# reported as skipped instead of being embedded under a guessed content type:
# a data URI is trusted by main without a magic check, so a wrong MIME here
# would produce a schema-valid document with a broken image in it.

def sniff_image(data):
    """(mime, extension) for a supported embedded image, else None."""
    if len(data) >= 4:
        if data[:4] == b"\x89PNG":
            return ("image/png", "png")
        if data[:3] == b"\xff\xd8\xff":
            return ("image/jpeg", "jpg")
        if data[:4] == b"GIF8":
            return ("image/gif", "gif")
        if data[:2] == b"BM":
            return ("image/bmp", "bmp")
        if data[:4] in (b"II*\x00", b"MM\x00*"):
            return ("image/tiff", "tiff")
    head = data[:512]
    i = 3 if head[:3] == b"\xef\xbb\xbf" else 0
    while i < len(head) and head[i:i + 1] in (b" ", b"\t", b"\r", b"\n"):
        i += 1
    low = head[i:].lower()
    if low.startswith(b"<svg") or low.startswith(b"<?xml") or low.startswith(b"<!doctype svg"):
        return ("image/svg+xml", "svg")
    return None


def pixel_dims(data):
    """(width, height) in pixels, or None — mirrors ImageSource.TryGetDimensions."""
    try:
        if data[:4] == b"\x89PNG" and len(data) >= 24:
            w = int.from_bytes(data[16:20], "big")
            h = int.from_bytes(data[20:24], "big")
            return (w, h) if w > 0 and h > 0 else None
        if data[:4] == b"GIF8" and len(data) >= 10:
            w = data[6] | (data[7] << 8)
            h = data[8] | (data[9] << 8)
            return (w, h) if w > 0 and h > 0 else None
        if data[:2] == b"BM" and len(data) >= 26:
            w = int.from_bytes(data[18:22], "little")
            h = abs(int.from_bytes(data[22:26], "little", signed=True))
            return (w, h) if w > 0 and h > 0 else None
        if data[:3] == b"\xff\xd8\xff":
            return _jpeg_dims(data)
    except (IndexError, ValueError):
        return None
    return None


def _jpeg_dims(data):
    i, n = 2, len(data)
    while i + 9 < n:
        if data[i] != 0xFF:
            return None
        marker = data[i + 1]
        if marker == 0xD8 or marker == 0x01 or 0xD0 <= marker <= 0xD7:
            i += 2
            continue
        if marker == 0xDA:
            return None
        seg = int.from_bytes(data[i + 2:i + 4], "big")
        is_sof = (0xC0 <= marker <= 0xCF) and marker not in (0xC4, 0xC8, 0xCC)
        if is_sof:
            h = int.from_bytes(data[i + 5:i + 7], "big")
            w = int.from_bytes(data[i + 7:i + 9], "big")
            return (w, h) if w > 0 and h > 0 else None
        if seg < 2:
            return None
        i += 2 + seg
    return None


def length_pt(value):
    """ODF length ('5.291cm', '2in', '150pt', '12') → points, or None."""
    if not value:
        return None
    m = re.match(r"^\s*(-?[0-9]*\.?[0-9]+)\s*(cm|mm|in|pt|pc|px)?\s*$", value)
    if not m:
        return None
    return float(m.group(1)) * UNITS_PT[m.group(2) or "px"]


def fmt_pt(points):
    """Points as an officecli length ('12pt'); officecli wants the unit."""
    return ("%.2f" % points).rstrip("0").rstrip(".") + "pt"


# ---------------------------------------------------------------------------
# style resolution
# ---------------------------------------------------------------------------

def collect_styles(root, reset=True):
    """(family, style-name) → {bold/italic/underline/align} for one XML part.

    Resolves style:parent-style-name one or more levels up, so a run span that
    inherits from a named character style keeps its weight. A Writer package is
    read twice: styles.xml carries the *named* styles, content.xml the
    *automatic* ones, and the second call passes reset=False so both survive.
    A name defined in both is taken from content.xml, the more specific part.
    """
    if reset:
        LIST_KINDS.clear()
    for ls in root.iter(q("text", "list-style")):
        ls_name = ls.get(q("style", "name"))
        if not ls_name:
            continue
        kinds = [local(c) for c in ls]
        LIST_KINDS[ls_name] = (
            "bullet" if any(k == "list-level-style-bullet" for k in kinds) else "ordered"
        )

    raw = {}
    parents = {}
    for st in root.iter(q("style", "style")):
        name = st.get(q("style", "name"))
        family = st.get(q("style", "family"))
        if not name or not family:
            continue
        props = {}
        tp = st.find(q("style", "text-properties"))
        if tp is not None:
            weight = (tp.get(q("fo", "font-weight")) or "").lower()
            if weight in BOLD_WEIGHTS:
                props["bold"] = "true"
            if (tp.get(q("fo", "font-style")) or "").lower() == "italic":
                props["italic"] = "true"
            underline = tp.get(q("style", "text-underline-style"))
            if underline and underline != "none":
                props["underline"] = "true"
            # ODF spells these two as attributes on style:text-properties; both
            # map onto a run property officecli already accepts (schemas/help/
            # docx/run.json declares strike and vertAlign).
            strike = (tp.get(q("style", "text-line-through-style")) or "").lower()
            if strike and strike != "none":
                props["strike"] = "true"
            pos = (tp.get(q("style", "text-position")) or "").strip().lower()
            if pos.startswith("super"):
                props["vertAlign"] = "superscript"
            elif pos.startswith("sub"):
                props["vertAlign"] = "subscript"
        pp = st.find(q("style", "paragraph-properties"))
        if pp is not None:
            align = (pp.get(q("fo", "text-align")) or "").lower()
            if align in ALIGN:
                props["align"] = ALIGN[align]
        raw[(family, name)] = props
        parent = st.get(q("style", "parent-style-name"))
        if parent:
            parents[(family, name)] = (family, parent)

    resolved = {}

    def resolve(key, depth=0):
        if key in resolved:
            return resolved[key]
        if depth > 8:
            return {}
        own = dict(raw.get(key, {}))
        parent = parents.get(key)
        if parent and parent != key:
            inherited = resolve(parent, depth + 1)
            merged = dict(inherited)
            merged.update(own)
            own = merged
        resolved[key] = own
        return own

    for key in raw:
        resolve(key)

    # document-wide default paragraph style, if the source declares one
    return resolved, raw


def style_props(styles, family, name):
    if not name:
        return {}
    return styles.get((family, name), {})


def image_items(images, width, height, zf, skipped, alt_hint=None):
    """Turn draw:image elements into ('image', bytes, mime, w, h, alt) items.

    The bytes are carried as a data URI by the emitter, so nothing has to
    survive on disk between this process and main's replay of its output.
    """
    out = []
    for img in images:
        href = img.get(q("xlink", "href"))
        if not href:
            skipped.note("draw:image without xlink:href (linked, not embedded)")
            continue
        if href.startswith("data:") or "://" in href:
            skipped.note("draw:image with an external href (not a package part)")
            continue
        part = urllib.parse.unquote(href)
        while part.startswith("./"):
            part = part[2:]           # ODF writes interior targets relative to /
        try:
            data = zf.read(part)
        except KeyError:
            skipped.note("draw:image '%s' missing from the package" % part)
            continue
        sniffed = sniff_image(data)
        if sniffed is None:
            # Name the construct, not just the file: a report a caller cannot
            # tie back to an element in the source is a report it cannot act on.
            skipped.note("draw:image '%s' dropped: not png/jpeg/gif/bmp/tiff/svg"
                         % part.rsplit("/", 1)[-1])
            continue
        mime, _ext = sniffed

        w, h = width, height
        dims = pixel_dims(data)
        if dims:
            ratio = float(dims[1]) / float(dims[0])
            if w is None and h is None:
                w, h = dims[0] * 0.75, dims[1] * 0.75   # CSS pixel = 1/96in
            elif w is None:
                w = h / ratio
            elif h is None:
                h = w * ratio
        elif w is None or h is None:
            skipped.note("image '%s' size unknown (no frame geometry, unreadable header)"
                         % part.rsplit("/", 1)[-1])

        alt = alt_hint or part.rsplit("/", 1)[-1]
        out.append(("image", data, mime, w, h, alt))
    return out


def frame_items(frame, zf, skipped):
    """Items for one draw:frame: its image(s), plus honest notes for the rest."""
    width = length_pt(frame.get(q("svg", "width")))
    height = length_pt(frame.get(q("svg", "height")))
    anchor = frame.get(q("text", "anchor-type"))
    if anchor and anchor != "as-char":
        skipped.note("image anchored '%s' (placed inline instead)" % anchor)

    alt_hint = None
    for tag in ("title", "desc"):
        el = frame.find(q("svg", tag))
        if el is not None and (el.text or "").strip():
            alt_hint = el.text.strip()
            break

    for kid in frame.iter():
        if local(kid) == "text-box":
            skipped.note("text box (draw:text-box): its text is dropped")
        elif local(kid) in ("object", "object-ole", "plugin", "applet"):
            # An embedded object — a formula, an OLE part — is a package of its
            # own, not a raster this reader can carry.
            skipped.note("%s embedded object (dropped)" % named(kid))

    images = [el for el in frame.iter() if local(el) == "image"]
    return image_items(images, width, height, zf, skipped, alt_hint)


# ---------------------------------------------------------------------------
# inline runs
# ---------------------------------------------------------------------------

def inline_items(elem, styles, inherited, skipped, zf):
    """Walk a paragraph-like element and return its inline items in order.

    Each item is ("text", text, props) or ("image", bytes, mime, w, h, alt).
    Order is document order, so "before <image> after" keeps its sequence.
    """
    out = []

    def walk(node, props):
        if node.text:
            out.append(("text", node.text, props))
        for child in node:
            ln = local(child)
            if ln == "s":
                n = child.get(q("text", "c"))
                try:
                    n = int(n) if n is not None else 1
                except ValueError:
                    n = 1
                out.append(("text", " " * max(1, min(n, 1024)), props))
            elif ln == "tab":
                out.append(("text", " ", props))
                skipped.note("text:tab (flattened to a space)")
            elif ln == "line-break":
                out.append(("text", " ", props))
                skipped.note("text:line-break (flattened to a space)")
            elif ln == "span":
                sp = dict(props)
                sp.update(style_props(styles, "text", child.get(q("text", "style-name"))))
                walk(child, sp)
            elif ln == "frame":
                out.extend(frame_items(child, zf, skipped))
            elif ln == "image":
                out.extend(image_items([child], None, None, zf, skipped))
            elif ln == "g":
                # a group of frames: descend, the individual frames are handled
                skipped.note("draw:g group (frames flattened in document order)")
                walk(child, props)
            else:
                if ln == "a":
                    # A hyperlink is its own element in the docx vocabulary
                    # (`add --type hyperlink` under the paragraph), not a run
                    # property, so it is collected as an item rather than
                    # flattened into the surrounding text.
                    start = len(out)
                    walk(child, props)
                    inner = out[start:]
                    text = text_of_items(inner)
                    href = child.get(q("xlink", "href")) or ""
                    if any(it[0] != "text" for it in inner):
                        skipped.note("text:a wrapping non-text content "
                                     "(link dropped, content kept)")
                    elif not text:
                        del out[start:]
                    elif not href:
                        skipped.note("text:a without xlink:href (text kept)")
                    elif href.startswith("#"):
                        # The target is a text:bookmark, which this reader does
                        # not convert — emitting w:anchor would produce a link
                        # that lands nowhere, so only the text is kept.
                        skipped.note("text:a internal anchor '#%s' "
                                     "(text kept; bookmark targets are not converted)"
                                     % urllib.parse.unquote(href[1:]))
                    elif "://" in href or href.startswith("mailto:"):
                        out[start:] = [("link", href, text, {"kind": "url"})]
                    else:
                        # A relative target would need a relationship to a part
                        # this conversion does not carry; keep the text.
                        skipped.note("text:a with a relative href '%s' "
                                     "(text kept, link dropped)" % href)
                    if child.tail:
                        out.append(("text", child.tail, props))
                    continue
                elif ln == "note":
                    # A footnote/endnote is its own element in the docx
                    # vocabulary (`add --type footnote|endnote` under the
                    # paragraph). Main appends its reference run at the *end* of
                    # the paragraph's run list, so emitting it here in item order
                    # is what puts the marker between "before" and "after"
                    # instead of at the end of the sentence.
                    kind, text, paras = note_text(child, styles, skipped, zf)
                    if not text:
                        skipped.note("text:note %s with an empty body (dropped)" % kind)
                    else:
                        if paras > 1:
                            skipped.note("text:note %s with %d paragraphs "
                                         "(joined with a line break)" % (kind, paras))
                        out.append(("note", kind, text))
                    if child.tail:
                        out.append(("text", child.tail, props))
                    continue
                elif ln in ("change", "change-start", "change-end"):
                    skipped.note("tracked change markup (flattened)")
                elif ln in ("page-number", "page-count", "date", "time",
                            "chapter", "title", "subject", "author",
                            "initial-creator", "creation-date", "creation-time",
                            "modification-date", "modification-time",
                            "print-date", "print-time", "description", "keywords"):
                    # A field is computed by the writer, not stored: only the
                    # cached text is in the file, so that is all that survives.
                    skipped.note("text:%s field (flattened to its cached text)"
                                 % ln)
                elif ln in ("bookmark", "bookmark-start", "bookmark-end",
                            "reference-mark", "reference-mark-start", "reference-mark-end",
                            "soft-page-break", "ruby"):
                    skipped.note("text:%s (dropped)" % ln)
                elif ln in ("bookmark-ref", "reference-ref", "note-ref"):
                    # A cross-reference points at a bookmark or a note. Its
                    # cached text is what the reader shows, so that is kept; the
                    # reference itself is not converted — and a document can
                    # carry thousands of them (one corpus file has 4,013), so
                    # staying quiet about it is not an option.
                    skipped.note("%s cross-reference (text kept, reference dropped)"
                                 % named(child))
                elif ln in ("user-field-get", "user-field-set", "user-field-input"):
                    skipped.note("%s (value kept as text, field dropped)" % named(child))
                elif ln in ("bibliography-mark", "bibliography-source"):
                    skipped.note("%s (citation anchor dropped)" % named(child))
                elif ln in ("sequence", "expression", "variable-set", "variable-get",
                            "variable-input", "meta", "meta-field", "measure",
                            "ruby-text", "caption"):
                    skipped.note("%s (not converted; its text is kept)" % named(child))
                elif ln == "control":
                    skipped.note("%s form control (dropped)" % named(child))
                elif ln in ("custom-shape", "rect", "circle", "ellipse", "line",
                            "polygon", "polyline", "path", "connector", "caption",
                            "chart", "object", "object-ole", "plugin", "applet",
                            "floating-frame", "handle"):
                    # A drawing, not a picture: there is no raster to embed.
                    skipped.note("draw:%s (vector shape or embedded object, dropped)" % ln)
                else:
                    # The class, closed rather than patched name by name: any
                    # element this reader has no rule for is named here, so a
                    # construct cannot leave a document without a word again.
                    skipped.note("%s (not converted; its text is kept)" % named(child))
                # descend so nested text is not lost
                walk(child, props)
            # The tail belongs to the parent's run of text, never to the child:
            # appending it once per child is what keeps "a <span>b</span> c"
            # from collapsing into "abc".
            if child.tail:
                out.append(("text", child.tail, props))

    walk(elem, inherited)
    return [it for it in out if it[0] in ("image", "link") or it[1]]


def text_of_items(items):
    return "".join(it[1] for it in items if it[0] == "text")


def note_text(note, styles, skipped, zf):
    """The body of a `text:note`: (kind, text, paragraph count).

    A note carries a single string in the docx vocabulary, so a multi-paragraph
    body is joined with a line break — main renders "\n" as <w:br/> inside the
    one note paragraph — and the caller reports that it happened. The citation
    marker (`text:note-citation`) is deliberately not carried: Word numbers the
    note itself, and the number in the source is that writer's own rendering of
    a sequence this conversion re-creates.
    """
    kind = (note.get(q("text", "note-class")) or "footnote").strip().lower()
    if kind not in ("footnote", "endnote"):
        skipped.note("text:note class '%s' (emitted as a footnote)" % kind)
        kind = "footnote"
    body = note.find(q("text", "note-body"))
    if body is None:
        return kind, "", 0
    paras = []
    for kid in body:
        if local(kid) != "p":
            skipped.note("text:%s inside a note body (dropped)" % local(kid))
            continue
        base = style_props(styles, "paragraph", kid.get(q("text", "style-name")))
        items = inline_items(kid, styles, base, skipped, zf)
        for it in items:
            if it[0] == "image":
                skipped.note("image inside a note body (a note carries text only)")
            elif it[0] == "note":
                skipped.note("nested text:note inside a note body (dropped)")
            elif it[0] == "link":
                skipped.note("hyperlink inside a note body (text kept, link dropped)")
        # Link text survives even though the link does not: the note is a string.
        paras.append("".join(it[1] if it[0] == "text" else it[2]
                             for it in items if it[0] in ("text", "link")))
    paras = [p for p in paras if p]
    return kind, "\n".join(paras), len(paras)


